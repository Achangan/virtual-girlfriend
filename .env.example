# 复制为 .env 后填写
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 语音合成：edge=免费免注册（默认）；volcano=火山引擎（需下面凭证）
TTS_PROVIDER=edge
TTS_EDGE_VOICE=zh-CN-XiaoyiNeural

# 火山引擎 TTS（https://console.volcengine.com/speech，TTS_PROVIDER=volcano 时生效）
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_CLUSTER=volcano_tts
TTS_VOICE=zh_female_qingxin

GIRL_NAME=紫曦
